{
  "rules_version": 1,
  "rules": {
    "entry": "one line of plain text equal to its own trim()",
    "whats_new": "1 to 4 entries, each 1 to 140 code points",
    "changes": "0 to 40 entries, each 1 to 300 code points",
    "forbidden_characters": "\\p{Cc} \\p{Cs} \\p{Co} \\p{Zl} \\p{Zp}, and \\p{Cf} except U+200C and U+200D",
    "forbidden_markup": "a backtick or asterisk anywhere; < followed by a letter, /, ! or ?; the sequence ](; an @mention: (^|[^A-Za-z0-9_])@[A-Za-z0-9-]",
    "forbidden_leading_markers": "^(?:[-+•*] |#{1,6} |>|\\d{1,9}[.)] )"
  },
  "whats_new": {
    "accept": [
      "Faster startup.",
      "The Updates window shows what is new in a release, with the full list of changes a click away.",
